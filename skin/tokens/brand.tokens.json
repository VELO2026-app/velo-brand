{
  "$extensions": {
    "velo-skin": {
      "displayName": "VELO",
      "shortName": "VELO",
      "themeColor": "#334D6E",
      "backgroundColor": "#ffffff",
      "fonts": [
        {
          "family": "Marmelad",
          "file": "assets/fonts/marmelad-subset.woff2",
          "weight": 400
        }
      ],
      "contrastExceptions": [
        {
          "text": "velo.text.secondary",
          "surface": "velo.bg.card.solid",
          "reason": "The golden secondary text is 70% of the text hue on the white card (3.12:1). The look is kept as designed; a value at 4.5:1 or more is a designer decision."
        }
      ]
    }
  }
}
