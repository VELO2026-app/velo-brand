{
  "$extensions": {
    "velo-skin": {
      "displayName": "VELO",
      "shortName": "VELO",
      "themeColor": "#334D6E",
      "backgroundColor": "#ffffff",
      "fonts": [
        {
          "family": "VELO Marmelad",
          "file": "assets/fonts/velo-marmelad-regular.woff2",
          "weight": 400
        },
        {
          "family": "VELO Marmelad",
          "file": "assets/fonts/velo-marmelad-medium.woff2",
          "weight": 500
        },
        {
          "family": "VELO Marmelad",
          "file": "assets/fonts/velo-marmelad-bold.woff2",
          "weight": 700
        }
      ],
      "contrastExceptions": [
        {
          "text": "velo.text.secondary",
          "surface": "velo.bg.card.solid",
          "reason": "The golden secondary text is 70% of the text hue on the white card (3.12:1). The look is kept as designed; a value at 4.5:1 or more is a designer decision."
        }
      ],
      "supportEmail": "support@velo.app"
    }
  }
}
